# Copy to .env and adjust as needed. Anything set here can also come from the real
# environment -- in production prefer real env vars over shipping this file.

# MongoDB connection string. Local dev: the compose service (mongodb://localhost:27017).
# Production: your Atlas cluster, mongodb+srv://user:pass@cluster.mongodb.net/crowdsentry
MONGO_URI=mongodb://localhost:27017
MONGO_DB=crowdsentry

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Shared API key for REST + WebSocket auth. EMPTY = auth disabled (fine for local dev,
# dangerous on a network). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend sends it as the X-API-Key header; set the same value as VITE_API_KEY
# when building the dashboard.
API_KEY=

# Interactive API docs at /docs, /redoc and /openapi.json. On in dev; leave unset
# (off) in production so the API surface is not advertised.
API_DOCS_ENABLED=true

# Comma-separated allowed Host headers (TrustedHostMiddleware). Empty disables the
# check; in production set it to the public hostname, e.g. crowdsentry.example.com
TRUSTED_HOSTS=

# Recompute per-camera hourly baselines inside the API process once a day. Without
# this (or an external scheduler running `python -m scripts.compute_baselines`),
# the historical_deviation feature stays at its cold-start default.
BASELINE_AUTO_ENABLED=false

# Uvicorn listen address -- read by the uvicorn command line, not by the app itself.
API_HOST=0.0.0.0
API_PORT=8000
