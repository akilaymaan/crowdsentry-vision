# Leave blank for same-origin API access: the Vite dev proxy in development, and the
# reverse proxy that serves the built bundle in production. Set this to the deployed
# API origin only when the frontend and backend are hosted on different origins.
VITE_API_BASE_URL=

# Shared API key, baked into the bundle at build time. Must match the backend's
# API_KEY. Leave empty when the backend runs with auth disabled (local dev).
VITE_API_KEY=
